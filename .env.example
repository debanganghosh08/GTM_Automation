# GTM Autopilot — copy to .env.local. Never commit real values.

# ---------------------------------------------------------------- core
# Local dev/test leaves this empty and uses an embedded Postgres (PGlite) at .pglite/.
# Production: the Supabase connection string (session pooler).
DATABASE_URL=
APP_URL=http://localhost:3000
SESSION_SECRET=dev-only-change-me
CRON_SECRET=dev-only-change-me

# ---------------------------------------------------------------- providers
# mock = offline deterministic fakes (default). live = real vendor calls.
# Per-provider override: PROVIDER_LEADS, PROVIDER_SENDING, PROVIDER_BILLING, etc.
PROVIDER_MODE=mock

# Anthropic — strategy + copy generation
ANTHROPIC_API_KEY=
MODEL_STRATEGY=claude-sonnet-5-5
MODEL_COPY=claude-sonnet-5-5
MODEL_CHEAP=claude-haiku-5-5

# Stripe — $0 30-day trial, then $2,000/month
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
SUBSCRIPTION_PRICE_CENTS=200000

# EmailBison (white-label instance)
EMAILBISON_BASE_URL=https://send.roister.ai
EMAILBISON_API_TOKEN=

# Lead data + verification
PROSPEO_API_KEY=
GETLEADS_API_KEY=
TRUELIST_API_KEY=

# Mailboxes + domains
INBOXKIT_API_KEY=
REGISTRAR_PROVIDER=porkbun
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_CLIENT_IP=

# ---------------------------------------------------------------- offer
LAUNCH_CREDITS=30000
TRIAL_DAYS=30
MAILBOX_PRICE_CENTS=3000
WARMUP_DAYS=7

# Registrar (Porkbun is the default; see docs/VENDOR_NOTES.md §4)
PORKBUN_API_KEY=
PORKBUN_SECRET_API_KEY=

# GetLeads: only set to true once a written SaaS agreement exists (VENDOR_NOTES §4)
GETLEADS_SAAS_APPROVED=false
