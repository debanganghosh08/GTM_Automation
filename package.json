{
  "name": "gtm-autopilot",
  "version": "0.1.0",
  "private": true,
  "description": "SparqLabs GTM Autopilot — self-serve outbound product",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "worker": "tsx scripts/worker.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "vitest run tests/e2e",
    "live-smoke": "tsx scripts/live-smoke.ts",
    "verify": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "@electric-sql/pglite": "0.2.17",
    "next": "^16.4.2",
    "pg": "8.13.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "stripe": "23.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.12.0",
    "@types/pg": "8.11.10",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.7.2",
    "vitest": "^5.0.5"
  }
}
